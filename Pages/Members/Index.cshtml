@page
@model RazorGoLfClubDB.Pages.Members.IndexModel
@{
    ViewData["Title"] = "Members";
}

<h1>Members</h1>

<!-- Create New Member Link -->
<p>
    <a asp-page="Create">Create New</a>
</p>

<!-- Filter by Gender -->
<form method="get" class="mb-3">
    <div class="form-group">
        <label for="GenderFilter">Filter by Gender:</label>
        <select asp-for="GenderFilter" class="form-control" onchange="this.form.submit()">
            <option value="">All</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
            <option value="Other">Other</option>
        </select>
    </div>
</form>

<!-- Filter by Handicap Range -->
<form method="get" class="mb-3">
    <div class="form-group">
        <label for="HandicapRangeFilter">Filter by Handicap:</label>
        <select asp-for="HandicapRangeFilter" class="form-control" onchange="this.form.submit()">
            <option value="">All</option>
            <option value="below10">Below 10</option>
            <option value="11to20">11 to 20</option>
            <option value="above20">Above 20</option>
        </select>
    </div>
</form>

<!-- View Bookings for a Member -->
<form method="get">
    <div class="form-group">
        <label for="MemberIdFilter">View Bookings for Member:</label>
        <select asp-for="MemberIdFilter" class="form-control" onchange="this.form.submit()">
            <option value="">Select Member</option>
            @foreach (var member in Model.Member)
            {
                <option value="@member.MemberID">@member.Name</option>
            }
        </select>
    </div>
</form>

<!-- Members Table -->
@if (Model.Member != null && Model.Member.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Member[0].Name)</th>
                <th>@Html.DisplayNameFor(model => model.Member[0].Email)</th>
                <th>@Html.DisplayNameFor(model => model.Member[0].Gender)</th>
                <th>@Html.DisplayNameFor(model => model.Member[0].Handicap)</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Member)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                    <td>@Html.DisplayFor(modelItem => item.Gender)</td>
                    <td>@Html.DisplayFor(modelItem => item.Handicap)</td>
                    <td>
                        <a asp-page="./Edit" asp-route-id="@item.MemberID">Edit</a> |
                        <a asp-page="./Details" asp-route-id="@item.MemberID">Details</a> |
                        <a asp-page="./Delete" asp-route-id="@item.MemberID">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No members found.</p>
}