@page
@model RazorGo1fClubDB.Pages.Bookings.CreateModel
@{
    ViewData["Title"] = "Create Booking";
}

<h1>Create Booking</h1>

<h4>Booking</h4>
<hr />
<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Tee Time -->
            <div class="form-group">
                <label asp-for="Booking.TeeTime" class="control-label"></label>
                <input asp-for="Booking.TeeTime" class="form-control" type="datetime-local" id="teeTimeInput" />
                <span asp-validation-for="Booking.TeeTime" class="text-danger"></span>
            </div>

            <!-- Member Dropdown -->
            <div class="form-group">
                <label asp-for="Booking.MemberId" class="control-label"></label>
                <select asp-for="Booking.MemberId" class="form-control" asp-items="ViewBag.MemberId">
                    <option value="">-- Select Member --</option>
                </select>
                <span asp-validation-for="Booking.MemberId" class="text-danger"></span>
            </div>

            <!-- Players Section -->
            <div class="form-group">
                <label>Players</label>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Handicap</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Players.Count; i++)
                        {
                            <tr>
                                <td>
                                    <input asp-for="Players[i].Name" class="form-control" />
                                    <span asp-validation-for="Players[i].Name" class="text-danger"></span>
                                </td>
                                <td>
                                    <input asp-for="Players[i].Handicap" class="form-control" />
                                    <span asp-validation-for="Players[i].Handicap" class="text-danger"></span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Submit Button -->
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // script to validate 15 minute intervals
        document.addEventListener("DOMContentLoaded", function () {
            const teeTimeInput = document.getElementById('teeTimeInput');

            teeTimeInput.addEventListener("change", function () {
                const date = new Date(this.value);
                const minutes = date.getMinutes();

                // Check if the minutes are in 15-minute intervals
                if (minutes % 15 !== 0) {
                    alert("Tee time must be in 15-minute intervals (e.g., 9:00, 9:15, 9:30).");
                    this.value = ""; // Clear the invalid input
                }
            });
        });
    </script>
}